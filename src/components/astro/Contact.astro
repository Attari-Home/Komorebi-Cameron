---
import Container from './Container.astro';
import ContactForm from '../react/ContactForm';
import { SITE } from '../../data/site';
---

<section id="contact" aria-labelledby="contact-heading" class="relative scroll-mt-24 py-28 lg:py-44">
  <Container>
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5" data-reveal>
        <p class="mb-8 flex items-center gap-3 text-xs font-medium uppercase tracking-[0.28em] text-fg-muted">
          <span aria-hidden="true" class="h-px w-10 bg-sakura-gradient"></span>
          Contact
        </p>
        <h2 id="contact-heading" class="i-text text-balance font-sans text-display-lg font-semibold">
          Let's build something
          <em class="accent-serif text-sakura-gradient inline-block pb-[0.1em] -mr-[0.02em] pr-[0.02em] text-[1.12em] leading-[0.9]">unforgettable</em>.
        </h2>
        <p class="i-text i-text-muted mt-8 max-w-md text-pretty text-lg leading-relaxed">
          Tell us what you are dreaming up. We take on a small number of
          projects at a time so each one gets our full attention.
        </p>

        <dl class="mt-12 space-y-6">
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.24em] text-fg-muted">Email</dt>
            <dd class="mt-2">
              <a
                href={`mailto:${SITE.contact.email}`}
                class="i-text text-xl font-semibold text-fg underline-offset-4 transition-colors hover:text-sakura-a hover:underline"
              >
                {SITE.contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.24em] text-fg-muted">Response time</dt>
            <dd class="i-text mt-2 text-lg text-fg">Usually {SITE.contact.responseTime}</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-7" data-reveal style="--reveal-delay: 140ms">
        <ContactForm client:only="react">
          <div
            slot="fallback"
            class="glass-strong rounded-3xl p-8 sm:p-10"
            role="status"
          >
            <p class="text-fg-muted">
              Loading the form… or write to us directly at
              <a class="font-semibold text-sakura-a" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>.
            </p>
          </div>
        </ContactForm>
      </div>
    </div>
  </Container>
</section>
