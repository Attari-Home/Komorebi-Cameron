---
import Container from './Container.astro';
import ContactForm from '../react/ContactForm';
import { SITE } from '../../data/site';
---

<section id="contact" aria-labelledby="contact-heading" class="relative scroll-mt-24 py-28 lg:py-44">
  <Container>
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-start lg:gap-x-16 xl:gap-x-24">
      <div class="min-w-0" data-reveal>
        <p class="mb-8 flex items-center gap-3 text-xs font-medium uppercase tracking-[0.28em] text-fg-muted">
          <span aria-hidden="true" class="h-px w-10 bg-sakura-gradient"></span>
          Contact
        </p>
        <h2 id="contact-heading" class="i-text font-sans text-[clamp(2.25rem,1.35rem+3.4vw,4.25rem)] font-semibold leading-[1.08] tracking-tight [overflow-wrap:normal] [hyphens:none]">
          Let's build something
          <em class="accent-serif text-sakura-gradient mt-1 inline-block whitespace-nowrap pb-[0.12em] pr-[0.02em] text-[1.1em] leading-[1]">unforgettable</em>.
        </h2>
        <p class="i-text i-text-muted mt-8 max-w-md text-pretty text-lg leading-relaxed">
          Tell us what you are dreaming up. We take on a small number of
          projects at a time so each one gets our full attention. Everything
          happens in writing, at your pace: no calls, no phone meetings.
        </p>

        <dl class="mt-12 space-y-6">
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.24em] text-fg-muted">Email</dt>
            <dd class="mt-2">
              <a
                href={`mailto:${SITE.contact.email}`}
                class="i-text inline-flex min-h-11 items-center text-xl font-semibold text-fg underline-offset-4 transition-colors hover:text-sakura-a hover:underline"
              >
                {SITE.contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.24em] text-fg-muted">Response window</dt>
            <dd class="i-text mt-2 text-lg text-fg">
              {SITE.contact.responseWindow}
              <span class="i-text-muted block text-base text-fg-muted">An in-depth technical review of every inquiry.</span>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-[0.24em] text-fg-muted">Where we talk</dt>
            <dd class="mt-3 flex flex-wrap gap-2">
              {
                SITE.contact.channels.map((channel) => (
                  <span class="glass-pill px-4 py-1.5 text-sm font-medium text-fg">{channel.label}</span>
                ))
              }
            </dd>
            <dd class="i-text i-text-muted mt-3 text-sm">100% async. Zero calls, ever.</dd>
          </div>
        </dl>
      </div>

      <div class="min-w-0" data-reveal style="--reveal-delay: 140ms">
        <ContactForm client:only="react">
          <div
            slot="fallback"
            class="glass-strong rounded-3xl p-8 sm:p-10"
            role="status"
          >
            <p class="text-fg-muted">
              Loading the form… or write to us directly at
              <a class="font-semibold text-sakura-a" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>.
            </p>
          </div>
        </ContactForm>
      </div>
    </div>
  </Container>
</section>
