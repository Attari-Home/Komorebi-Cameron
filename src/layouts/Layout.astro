---
/**
 * Layout.astro — document shell.
 *
 * Responsibilities:
 *  - <head>: charset, viewport, SEO + Open Graph + Twitter tags, canonical
 *  - Self-hosted font loading with preloads for the two above-the-fold files
 *  - Schema.org ProfessionalService JSON-LD
 *  - Blocking inline script that applies the theme BEFORE first paint (no FOUC)
 */
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '../styles/global.css';

import jakartaFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import cormorantItalicFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';

import SmoothScrollProvider from '../components/react/SmoothScrollProvider';
import CanvasStage from '../components/react/CanvasStage';
import GuidePetal from '../components/react/GuidePetal';
import LiquidThemeTransition from '../components/react/LiquidThemeTransition';
import { SITE } from '../data/site';
import { PRICING_TIERS } from '../data/pricing';
import type { FaqItem } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  /** Path portion only, e.g. "/" or "/about". Resolved against Astro.site. */
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Questions to emit as FAQPage structured data. */
  faq?: readonly FaqItem[];
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  ogImage = SITE.ogImage,
  ogImageAlt = SITE.ogImageAlt,
  noindex = false,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL(SITE.url)).toString();
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
// The canonical URL must include the deployment base path (e.g. /Komorebi-Cameron
// on GitHub Pages); resolving a bare "/" against the origin would point at the wrong page.
const canonicalUrl = new URL(BASE + (canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`), siteOrigin).toString();
const ogImageUrl = new URL(ogImage.startsWith('/') ? BASE + ogImage : ogImage, siteOrigin).toString();

// ---- Schema.org structured data (one linked @graph) -----------------------
// URLs derive from the real deployment origin + base path, so they stay correct
// on GitHub Pages and automatically follow a custom domain once one is set.
const siteUrl = new URL(`${BASE}/`, siteOrigin).toString(); // always ends with "/"
const orgId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const faqItems = Astro.props.faq ?? [];

const offerCatalog = {
  '@type': 'OfferCatalog',
  name: `${SITE.name} Services and Packages`,
  itemListElement: [
    ...SITE.services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.description },
    })),
    ...PRICING_TIERS.map((tier) => ({
      '@type': 'Offer',
      name: tier.name,
      description: tier.summary,
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: tier.price,
        priceCurrency: 'USD',
      },
      itemOffered: { '@type': 'Service', name: tier.name, serviceType: 'Web development' },
    })),
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': orgId,
      name: SITE.name,
      legalName: SITE.legalName,
      url: siteUrl,
      description: SITE.description,
      slogan: 'Crafting Unforgettable Digital Experiences',
      image: ogImageUrl,
      logo: {
        '@type': 'ImageObject',
        url: new URL(BASE + '/favicon.svg', siteOrigin).toString(),
      },
      email: SITE.contact.email,
      priceRange: `$${PRICING_TIERS[0].price.toLocaleString('en-US')}+`,
      areaServed: 'Worldwide',
      availableLanguage: 'English',
      knowsAbout: [
        'Web development',
        'Creative engineering',
        'HTML5 canvas graphics',
        'WebGL',
        'Astro',
        'Search engine optimization',
        'Core Web Vitals',
        'Web performance',
      ],
      serviceType: SITE.services.map((s) => s.name),
      hasOfferCatalog: offerCatalog,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: SITE.contact.email,
        availableLanguage: 'English',
      },
      ...(SITE.sameAs.length > 0 ? { sameAs: SITE.sameAs } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': websiteId },
      about: { '@id': orgId },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
    },
    ...(faqItems.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonicalUrl}#faq`,
            mainEntity: faqItems.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: { '@type': 'Answer', text: item.answer },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Blocking theme script. Runs before first paint so the correct theme is on
      <html> before any CSS is applied — this is what prevents the dark/light
      flash on reload. Keep storage key + attribute in sync with src/lib/theme.ts.
    -->
    <script is:inline>
      (function () {
        var KEY = 'kc-theme';
        var theme = 'dark';
        try {
          var stored = window.localStorage.getItem(KEY);
          if (stored === 'dark' || stored === 'light') {
            theme = stored;
          } else if (
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: light)').matches
          ) {
            theme = 'light';
          }
        } catch (e) {
          if (
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: light)').matches
          ) {
            theme = 'light';
          }
        }
        var root = document.documentElement;
        root.classList.add('js');
        root.setAttribute('data-theme', theme);
        try {
          var pal = window.localStorage.getItem('kc-petal-palette');
          if (pal === 'sakura' || pal === 'golden' || pal === 'velvet' || pal === 'ghost') {
            root.setAttribute('data-petal-palette', pal);
          }
        } catch (e) {}
        root.style.colorScheme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#FAF7F8' : '#0A0A0C');
      })();
    </script>

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark light" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="format-detection" content="telephone=no" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BASE}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BASE}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE}/site.webmanifest`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Font preloads: only the two files needed above the fold -->
    <link rel="preload" href={jakartaFont} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={cormorantItalicFont}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="font-sans text-fg antialiased">
    <a
      href="#main"
      class="sr-only-focusable fixed left-4 top-4 z-[100] rounded-full bg-sakura-a px-5 py-2.5 text-sm font-semibold text-obsidian"
    >
      Skip to content
    </a>

    <!--
      Fixed, full-viewport canvas behind all content (petals fall through the
      whole page; branches fade out after the hero). 100lvh so mobile URL-bar
      changes never resize it.
    -->
    <div
      aria-hidden="true"
      class="ambient-bg pointer-events-none fixed inset-0 -z-20"
    ></div>

    <div
      id="canvas-root"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 -z-10"
      style="height: 100vh; height: 100lvh"
    >
      <CanvasStage client:only="react" />
    </div>

    <SmoothScrollProvider client:only="react" />
    <GuidePetal client:only="react" />
    <LiquidThemeTransition client:only="react" />

    <slot />

    <script>
      import '../scripts/enhance';
    </script>
  </body>
</html>
