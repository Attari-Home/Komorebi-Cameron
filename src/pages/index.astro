---
import Layout from '../layouts/Layout.astro';
import Header from '../components/astro/Header.astro';
import Hero from '../components/astro/Hero.astro';
import TrustBar from '../components/astro/TrustBar.astro';
import Manifesto from '../components/astro/Manifesto.astro';
import Services from '../components/astro/Services.astro';
import Process from '../components/astro/Process.astro';
import Impact from '../components/astro/Impact.astro';
import Pricing from '../components/astro/Pricing.astro';
import Contact from '../components/astro/Contact.astro';
import Footer from '../components/astro/Footer.astro';
---

<Layout canonicalPath="/">
  <Header />

  <main id="main">
    <Hero />
    <TrustBar />
    <Manifesto />
    <Services />
    <Process />
    <Impact />
    <Pricing />
    <Contact />
  </main>

  <Footer />
</Layout>
